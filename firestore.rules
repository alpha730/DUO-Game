rules_version = '2';

// SPEC §6. The phone never writes: every write goes through a Cloud Function (admin SDK bypasses rules).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Owner-only reads.
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;

      match /catches/{lingoId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow write: if false;
      }
    }

    // Public-to-players reads.
    match /lingos/{id} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /config/{id} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /leaderboard/{id} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /raids/{id} {
      allow read: if signedIn();
      allow write: if false;
      // The joined counter's shards: the waiting room sums them live.
      match /shards/{shard} {
        allow read: if signedIn();
        allow write: if false;
      }
      // raids/{id}/players/* falls through to default deny.
    }
    match /prizes/{id} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /final/{id} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Everything else (attempts, challenges, pointsLog, redemptions, raid players): denied.
  }
}
