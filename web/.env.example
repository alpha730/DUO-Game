# Copy to .env (git-ignored). Values from Firebase console → Project settings → Your apps → Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# "true" = talk to local emulators (default when opened on localhost).
VITE_USE_EMULATORS=
# App Check (anti-cheat, README → App Check): the reCAPTCHA Enterprise KEY ID (public, score-based
# website key). Without it the live app can't call the functions (App Check is enforced).
VITE_RECAPTCHA_SITE_KEY=
# Only for a test/preview build opened on a desktop: a debug token registered in Firebase console →
# App Check → Apps → Manage debug tokens. NEVER set it for the live build.
VITE_APPCHECK_DEBUG_TOKEN=
