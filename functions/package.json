{
  "name": "functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "prebuild": "node scripts/copy-shared.mjs",
    "build": "tsc",
    "build:watch": "npm run prebuild && tsc --watch",
    "pretest": "node scripts/copy-shared.mjs",
    "test": "vitest run",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test:emu": "vitest run --config vitest.emu.config.ts",
    "test:emu:ci": "npm run build && firebase emulators:exec --only auth,firestore,functions \"npm run test:emu\""
  },
  "dependencies": {
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^6.6.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^22.20.4",
    "firebase": "^12.19.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
