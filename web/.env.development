# Local dev (`npm run dev`) always talks to the emulators under the demo project.
# Overrides web/.env, which holds the real project config used by `npm run build`.
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-decade-hunt.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-decade-hunt
VITE_FIREBASE_APP_ID=demo-app
VITE_USE_EMULATORS=true
